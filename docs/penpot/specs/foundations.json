                {"key": "txt", "tokenName": "color.ext.txt", "literalFill": "#495057", "label": "txt"}
            ]
        },
        {
            "id": "color-surface",
            "title": "COLOR · SURFACE  (theme-variant — re-skins per active theme)",
            "y": 728,
            "kind": "swatchRow",
            "items": [
                {"key": "canvas",  "tokenName": "color.surface.canvas",  "literalFill": "#FFFFFF",     "label": "canvas"},
                {"key": "raised",  "tokenName": "color.surface.raised",  "literalFill": "#F8F9FA",     "label": "raised"},
                {"key": "sunken",  "tokenName": "color.surface.sunken",  "literalFill": "#E9ECEF",     "label": "sunken"},
                {"key": "overlay", "tokenName": "color.surface.overlay", "literalFill": "#3D3D3D",     "label": "overlay"}
            ]
        },
        {
            "id": "color-text",
            "title": "COLOR · TEXT  (theme-variant)",
            "y": 848,
            "kind": "swatchRow",
            "items": [
                {"key": "primary",   "tokenName": "color.text.primary",   "literalFill": "#212529", "label": "primary"},
                {"key": "secondary", "tokenName": "color.text.secondary", "literalFill": "#495057", "label": "secondary"},
                {"key": "muted",     "tokenName": "color.text.muted",     "literalFill": "#6C757D", "label": "muted"},
                {"key": "on-brand",  "tokenName": "color.text.on-brand",  "literalFill": "#FFFFFF", "label": "on-brand"},
                {"key": "inverse",   "tokenName": "color.text.inverse",   "literalFill": "#FFFFFF", "label": "inverse"}
            ]
        },
        {
            "id": "color-border",
            "title": "COLOR · BORDER  (theme-variant — stroke binding)",
            "y": 968,
            "kind": "borderRow",
            "items": [
                {"key": "subtle",  "tokenName": "color.border.subtle",  "literalStroke": "#E9ECEF", "label": "subtle"},
                {"key": "default", "tokenName": "color.border.default", "literalStroke": "#DEE2E6", "label": "default"},
                {"key": "strong",  "tokenName": "color.border.strong",  "literalStroke": "#ADB5BD", "label": "strong"}
            ]
        },
        {
            "id": "color-state",
            "title": "COLOR · STATE  (theme-variant — bg + fg pairs)",
            "y": 1088,
            "kind": "pillRow",
            "items": [
                {"key": "success", "bgToken": "color.state.success-bg", "fgToken": "color.state.success-fg", "literalBg": "#D4EDDA", "literalFg": "#155724", "label": "success"},
                {"key": "warning", "bgToken": "color.state.warning-bg", "fgToken": "color.state.warning-fg", "literalBg": "#FFF3CD", "literalFg": "#856404", "label": "warning"},
                {"key": "danger",  "bgToken": "color.state.danger-bg",  "fgToken": "color.state.danger-fg",  "literalBg": "#F8D7DA", "literalFg": "#721C24", "label": "danger"},
                {"key": "info",    "bgToken": "color.state.info-bg",    "fgToken": "color.state.info-fg",    "literalBg": "#D1ECF1", "literalFg": "#0C5460", "label": "info"}
            ]
        },
        {
            "id": "spacing",
            "title": "SPACING SCALE  (8 px grid — bar width is the token value)",
            "y": 1208,
            "kind": "spacingScale",
            "items": [
                {"key": "0", "tokenName": "spacing.0", "literalWidth": 1,  "label": "0  (0px)"},
                {"key": "1", "tokenName": "spacing.1", "literalWidth": 4,  "label": "1  (4px)"},
                {"key": "2", "tokenName": "spacing.2", "literalWidth": 8,  "label": "2  (8px)"},
                {"key": "3", "tokenName": "spacing.3", "literalWidth": 12, "label": "3  (12px)"},
                {"key": "4", "tokenName": "spacing.4", "literalWidth": 16, "label": "4  (16px)"},
                {"key": "5", "tokenName": "spacing.5", "literalWidth": 24, "label": "5  (24px)"},
                {"key": "6", "tokenName": "spacing.6", "literalWidth": 32, "label": "6  (32px)"},
                {"key": "7", "tokenName": "spacing.7", "literalWidth": 48, "label": "7  (48px)"}
            ]
        },
        {
            "id": "radius",
            "title": "RADIUS SCALE  (4 corners bound r1..r4)",
            "y": 1448,
            "kind": "radiusRow",
            "items": [
                {"key": "sm",   "tokenName": "radius.sm",   "literalRadius": 3,   "label": "sm  (3px)"},
                {"key": "base", "tokenName": "radius.base", "literalRadius": 4,   "label": "base  (4px)"},
                {"key": "lg",   "tokenName": "radius.lg",   "literalRadius": 6,   "label": "lg  (6px)"},
                {"key": "pill", "tokenName": "radius.pill", "literalRadius": 999, "label": "pill  (999px)"}
            ]
        },
        {
            "id": "typography-size",
            "title": "TYPOGRAPHY · SIZE RAMP  (weight=normal, font-size token-bound)",
            "y": 1608,
            "kind": "typeRamp",
            "rowHeight": 56,
            "fontWeight": "400",
            "items": [
                {"key": "xs",   "tokenName": "font-size.xs",   "literalSize": 12, "label": "xs  12px",  "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "sm",   "tokenName": "font-size.sm",   "literalSize": 13, "label": "sm  13px",  "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "base", "tokenName": "font-size.base", "literalSize": 14, "label": "base  14px", "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "lg",   "tokenName": "font-size.lg",   "literalSize": 16, "label": "lg  16px",   "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "xl",   "tokenName": "font-size.xl",   "literalSize": 18, "label": "xl  18px",   "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "2xl",  "tokenName": "font-size.2xl",  "literalSize": 22, "label": "2xl  22px",  "sample": "The quick brown fox jumps over the lazy dog."},
                {"key": "3xl",  "tokenName": "font-size.3xl",  "literalSize": 28, "label": "3xl  28px",  "sample": "Quick brown fox."},
                {"key": "4xl",  "tokenName": "font-size.4xl",  "literalSize": 36, "label": "4xl  36px",  "sample": "Quick brown fox."}
            ]
        },
        {
            "id": "typography-weight",
            "title": "TYPOGRAPHY · WEIGHT  (size=18px, font-weight token-bound)",
            "y": 2080,
            "kind": "weightRamp",
            "rowHeight": 36,
            "fontSize": 18,
            "items": [
                {"key": "light",    "tokenName": "font-weight.light",    "literalWeight": "300", "label": "light  300",    "sample": "The quick brown fox."},
                {"key": "normal",   "tokenName": "font-weight.normal",   "literalWeight": "400", "label": "normal  400",   "sample": "The quick brown fox."},
                {"key": "medium",   "tokenName": "font-weight.medium",   "literalWeight": "500", "label": "medium  500",   "sample": "The quick brown fox."},
                {"key": "semibold", "tokenName": "font-weight.semibold", "literalWeight": "600", "label": "semibold  600", "sample": "The quick brown fox."},
                {"key": "bold",     "tokenName": "font-weight.bold",     "literalWeight": "700", "label": "bold  700",     "sample": "The quick brown fox."}
            ]
        },
        {
            "id": "elevation",
            "title": "ELEVATION DECK  (theme-variant — shadow not bindable in tokensLib; values baked from theme-light)",
            "y": 2280,
            "kind": "elevationDeck",
            "items": [
                {"key": "0", "label": "elevation.0", "literalShadow": null},
                {"key": "1", "label": "elevation.1", "literalShadow": {"offset-x": 0, "offset-y": 1,  "blur": 3,  "spread": 0, "color": "#000000", "opacity": 0.08, "style": "drop-shadow"}},
                {"key": "2", "label": "elevation.2", "literalShadow": {"offset-x": 0, "offset-y": 4,  "blur": 6,  "spread": 0, "color": "#000000", "opacity": 0.10, "style": "drop-shadow"}},
                {"key": "3", "label": "elevation.3", "literalShadow": {"offset-x": 0, "offset-y": 4,  "blur": 18, "spread": 0, "color": "#000000", "opacity": 0.08, "style": "drop-shadow"}},
                {"key": "4", "label": "elevation.4", "literalShadow": {"offset-x": 0, "offset-y": 20, "blur": 25, "spread": 0, "color": "#000000", "opacity": 0.14, "style": "drop-shadow"}}
            ]
        },
        {
            "id": "motion",
            "title": "MOTION  (visual reference — duration/cubic-bezier not bindable in Penpot tokensLib)",
            "y": 2420,
            "kind": "motionStrips",
            "items": [
                {"key": "duration-fast", "label": "duration.fast  100ms",  "type": "duration", "value": 100},
                {"key": "duration-base", "label": "duration.base  150ms",  "type": "duration", "value": 150},
                {"key": "duration-slow", "label": "duration.slow  300ms",  "type": "duration", "value": 300},
                {"key": "easing-standard",   "label": "easing.standard  cubic-bezier(0.4, 0, 0.2, 1)", "type": "easing"},
                {"key": "easing-decelerate", "label": "easing.decelerate  cubic-bezier(0, 0, 0.2, 1)", "type": "easing"},
                {"key": "easing-accelerate", "label": "easing.accelerate  cubic-bezier(0.4, 0, 1, 1)", "type": "easing"}
            ]
        }
    ]
}
