                {"key": "1", "tokenName": "color.bucket.1", "literalFill": "#4263EB", "label": "1"},
                {"key": "2", "tokenName": "color.bucket.2", "literalFill": "#1098AD", "label": "2"},
                {"key": "3", "tokenName": "color.bucket.3", "literalFill": "#2F9E44", "label": "3"},
                {"key": "4", "tokenName": "color.bucket.4", "literalFill": "#F08C00", "label": "4"},
                {"key": "5", "tokenName": "color.bucket.5", "literalFill": "#D6336C", "label": "5"},
                {"key": "6", "tokenName": "color.bucket.6", "literalFill": "#AE3EC9", "label": "6"},
                {"key": "7", "tokenName": "color.bucket.7", "literalFill": "#5F3DC4", "label": "7"},
                {"key": "8", "tokenName": "color.bucket.8", "literalFill": "#495057", "label": "8"}
            ]
        },
        {
            "id": "color-neutral",
            "title": "COLOR · NEUTRAL SCALE  (theme-invariant)",
            "y": 488,
            "kind": "swatchRow",
            "swatchWidth": 104,
            "items": [
                {"key": "0",   "tokenName": "color.neutral.0",   "literalFill": "#FFFFFF", "label": "0"},
                {"key": "100", "tokenName": "color.neutral.100", "literalFill": "#F8F9FA", "label": "100"},
                {"key": "200", "tokenName": "color.neutral.200", "literalFill": "#E9ECEF", "label": "200"},
                {"key": "300", "tokenName": "color.neutral.300", "literalFill": "#DEE2E6", "label": "300"},
