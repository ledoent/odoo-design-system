                {"key": "950", "tokenName": "color.neutral.950", "literalFill": "#0F1115", "label": "950"}
            ]
        },
        {
            "id": "color-ext",
            "title": "COLOR · FILE EXTENSION  (theme-invariant)",
            "y": 608,
            "kind": "swatchRow",
            "items": [
                {"key": "pdf", "tokenName": "color.ext.pdf", "literalFill": "#D6336C", "label": "pdf"},
                {"key": "doc", "tokenName": "color.ext.doc", "literalFill": "#1971C2", "label": "doc"},
                {"key": "xls", "tokenName": "color.ext.xls", "literalFill": "#2F9E44", "label": "xls"},
                {"key": "ppt", "tokenName": "color.ext.ppt", "literalFill": "#E8590C", "label": "ppt"},
