{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$description": "Declarative spec for the 'Foundations' Penpot page (index 1). Drives `scripts/penpot-build-phase-2-specimens.mjs` (authoring) and `tests/foundations.test.mjs` (live contract). Sections stack vertically; the build script computes per-item x/y from `defaults` + section.y. Token bindings use the kebab-case PCS attribute keys documented in `docs/penpot/specs/token-fill.json` (`fill`, `stroke-color`, `r1..r4`, `width`, `font-size`, `font-weight`). Shadow / duration / cubic-bezier types are not bindable via Penpot tokensLib; those sections use literal values pulled from `odoo_design_system/static/src/tokens/design-system.dtcg.json`.",

    "page": {
        "name": "01 — Foundations",
        "width": 1440,
        "height": 2520
    },

    "defaults": {
        "marginX": 64,
        "swatchWidth": 96,
        "swatchHeight": 64,
        "swatchGap": 16,
        "labelHeight": 14,
        "labelOffset": 8,
        "sectionHeaderHeight": 16,
        "sectionContentOffset": 24,
        "fontFamily": "sourcesanspro",
        "fontId": "gfont-sourcesanspro"
    },

    "sections": [
        {
            "id": "color-brand",
            "title": "COLOR · BRAND  (theme-invariant)",
            "y": 128,
            "kind": "swatchRow",
            "items": [
                {"key": "primary",        "tokenName": "color.brand.primary",        "literalFill": "#D97706", "label": "primary"},
                {"key": "primary-hover",  "tokenName": "color.brand.primary-hover",  "literalFill": "#B45309", "label": "primary-hover"},
                {"key": "primary-active", "tokenName": "color.brand.primary-active", "literalFill": "#92400E", "label": "primary-active"},
                {"key": "secondary",      "tokenName": "color.brand.secondary",      "literalFill": "#F59E0B", "label": "secondary"}
            ]
        },
        {
            "id": "color-portal",
            "title": "COLOR · PORTAL  (theme-invariant)",
            "y": 248,
            "kind": "swatchRow",
            "items": [
                {"key": "nav-dark",      "tokenName": "color.portal.nav-dark",      "literalFill": "#1A1A1E", "label": "nav-dark"},
                {"key": "sidebar-light", "tokenName": "color.portal.sidebar-light", "literalFill": "#FAFAF8", "label": "sidebar-light"},
                {"key": "border",        "tokenName": "color.portal.border",        "literalFill": "#E5E5E5", "label": "border"}
            ]
        },
        {
