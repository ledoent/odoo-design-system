<templates xml:space="preserve">
    <t t-name="oca_design_system.OcaChip">
        <span
            t-att-class="className"
            t-att-data-ext="props.dataExt"
        >
            <i t-if="props.icon" t-attf-class="fa {{ props.icon }} me-1" aria-hidden="true"/>
            <t t-if="props.label" t-esc="props.label"/>
            <t t-slot="default"/>
        </span>
    </t>
</templates>
