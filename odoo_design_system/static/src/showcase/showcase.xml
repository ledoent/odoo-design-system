<templates xml:space="preserve">
    <t t-name="odoo_design_system.Showcase">
        <div class="ods_showcase">
            <h1>OCA Design System — Odoo 19</h1>
            <p class="ods_lead">
                Shared OWL components + CSS tokens for OCA UI work. Copy a snippet,
                adjust the props, and the result will read visually consistent with every
                other OCA module that uses this addon.
            </p>

            <!-- Tokens -->
            <section class="ods_section">
                <h2>Tokens</h2>
                <div class="ods_card">
                    <table class="ods_token_table">
                        <thead>
                            <tr>
                                <th>Variable</th>
                                <th>Default</th>
                                <th>Purpose</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="tokens" t-as="t" t-key="t.name">
                                <td t-esc="t.name"/>
                                <td t-esc="t.value"/>
                                <td t-esc="t.purpose"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Bucket palette -->
            <section class="ods_section">
                <h2>Bucket palette</h2>
                <p class="ods_lead">
                    Eight semantic buckets. Any identity (a record name, a creator initial,
                    a file family) deterministically hashes into one of these.
                </p>
                <div class="ods_card">
                    <div class="ods_demo">
                        <span t-foreach="buckets" t-as="b" t-key="b.n"
                              class="ods_chip"
                              t-attf-style="background: {{ b.hex }}; color: white;"
                              t-esc="b.n"/>
                    </div>
                </div>
            </section>

            <!-- Chips -->
            <section class="ods_section">
                <h2>Chips — `&lt;OdsChip&gt;`</h2>
                <div class="ods_grid">
                    <div class="ods_card">
                        <div class="ods_demo">
                            <OdsChip label="'2.4 MB'" variant="'size'"/>
                            <OdsChip label="5" icon="'fa-folder'" variant="'count'"/>
                            <OdsChip icon="'fa-lock'" variant="'warning'" label="'Locked'"/>
                            <OdsChip icon="'fa-unlock-alt'" variant="'success'" label="'Locked by me'"/>
                            <OdsChip t-foreach="extensions" t-as="ext" t-key="ext"
                                     variant="'ext'"
                                     dataExt="ext"
                                     label="ext.toUpperCase()"/>
                        </div>
                    </div>
                    <pre class="ods_code">
&lt;OdsChip variant="'size'" label="'2.4 MB'"/&gt;
&lt;OdsChip variant="'count'" icon="'fa-folder'" label="5"/&gt;
&lt;OdsChip variant="'warning'" icon="'fa-lock'" label="'Locked'"/&gt;
&lt;OdsChip variant="'ext'" dataExt="'pdf'" label="'PDF'"/&gt;
                    </pre>
                </div>
            </section>

            <!-- Initials avatars -->
            <section class="ods_section">
                <h2>Initials — `&lt;OdsInitialsAvatar&gt;`</h2>
                <div class="ods_grid">
                    <div class="ods_card">
                        <div class="ods_demo">
                            <OdsInitialsAvatar t-foreach="people" t-as="person" t-key="person"
                                               name="person"/>
                        </div>
                    </div>
                    <pre class="ods_code">
&lt;OdsInitialsAvatar name="'Mitchell Admin'"/&gt;

&lt;!-- Size override --&gt;
&lt;OdsInitialsAvatar name="'M'" size="32"/&gt;
                    </pre>
                </div>
            </section>

            <!-- Card tiles -->
            <section class="ods_section">
                <h2>Card tiles — `&lt;OdsCardTile&gt;`</h2>
                <div class="ods_grid">
                    <div class="ods_card">
                        <div class="ods_demo">
                            <OdsCardTile t-foreach="extensions" t-as="ext" t-key="ext"
                                         accent="'ext'"
                                         dataExt="ext">
                                <i t-attf-class="fa fa-file-{{ ext }}-o" aria-hidden="true"/>
                            </OdsCardTile>
                        </div>
                    </div>
                    <pre class="ods_code">
&lt;OdsCardTile accent="'ext'" dataExt="'pdf'" imgSrc="iconUrl"/&gt;

&lt;!-- Directory: hash-tint by first-letter of name --&gt;
&lt;OdsCardTile accent="'initial'" name="'Documents'"/&gt;

&lt;!-- Real photo preview --&gt;
&lt;OdsCardTile accent="'preview'" imgSrc="thumbUrl"/&gt;
                    </pre>
                </div>
            </section>

            <!-- Icons -->
            <section class="ods_section">
                <h2>Icons — `&lt;OdsIcon&gt;`</h2>
                <p class="ods_lead">
                    Bundled OSS icon sets, available at runtime via the addon's
                    static path. Each set ships with its upstream LICENSE alongside
                    the SVGs.
                </p>
                <div t-foreach="iconSets" t-as="iset" t-key="iset.set"
                     class="ods_card" style="margin-bottom: 16px;">
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <div>
                            <strong t-esc="iset.set"/>
                            <span class="text-muted ms-2">
                                — <t t-esc="iset.count"/> icons</span>
                        </div>
                        <span class="text-muted small" t-esc="iset.license"/>
                    </div>
                    <div class="ods_demo" style="gap: 12px;">
                        <OdsIcon t-foreach="iset.samples" t-as="iname" t-key="iname"
                                 name="iname"
                                 set="iset.set"
                                 size="24"
                                 title="iname"/>
                    </div>
                </div>
                <pre class="ods_code">
&lt;OdsIcon name="'folder-open'" set="'lucide'" size="20"/&gt;
&lt;OdsIcon name="'document-text'" set="'heroicons'"/&gt;
&lt;OdsIcon name="'check'" set="'heroicons-mini'" size="16"/&gt;
                </pre>
            </section>

            <!-- Card chrome mixin -->
            <section class="ods_section">
                <h2>Card chrome — `@include ods-card-chrome($selector)`</h2>
                <p class="ods_lead">
                    A Sass mixin that adds an accent spine + hover lift to any card selector.
                </p>
                <div class="ods_grid">
                    <div class="ods_card">
                        <pre class="ods_code">
// In your module's SCSS
@include ods-card-chrome(".my_app_card");
                        </pre>
                    </div>
                    <div class="ods_card">
                        <p>Effect:</p>
                        <ul>
                            <li>3px accent stripe on the left edge, colored by <code>--ods-accent</code></li>
                            <li>Subtle 1px lift + shadow on hover</li>
                            <li>Stays compatible with Odoo's <code>highlight_color</code> kanban-color border</li>
                        </ul>
                    </div>
                </div>
            </section>

        </div>
    </t>
</templates>
